+	CONVERT_FIELD(level);
+	CONVERT_FIELD(optname);
+	CONVERT_FIELD(optlen);
+	CONVERT_FIELD(retval);
+	CONVERT_FIELD(optval);
+	CONVERT_FIELD(optval_end);
+	}
+#undef CONVERT_FIELD
+	return insn - buffer;
+}
